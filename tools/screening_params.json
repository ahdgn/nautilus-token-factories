{
  "_comment": "Seuils du screening Cogen → Compute France. Lus par tools/build_datasets.py. Toute modification est documentée dans METHODOLOGIE.md.",
  "version": "v0 (26/09/2026)",
  "source": {
    "api": "https://odre.opendatasoft.com/api/explore/v2.1/catalog/datasets/",
    "dataset": "registre-national-installation-production-stockage-electricite-agrege",
    "where": "filiere=\"Thermique non renouvelable\" AND codecombustible=\"GAZ\"",
    "communes": "https://geo.api.gouv.fr/communes?fields=nom,code,centre,codeDepartement&format=json"
  },
  "perimetre": {
    "gestionnaires_exclus": ["RTE"],
    "regions_exclues": ["Guadeloupe", "Martinique", "Guyane", "La Réunion", "Mayotte", "Corse"],
    "puissance_kw_min": 1000,
    "puissance_kw_max": 20000,
    "filtre_technologie": false
  },
  "cohortes": [
    {"label": "avant 1995", "max": 1994},
    {"label": "1995-2010", "min": 1995, "max": 2010},
    {"label": "2011-2014", "min": 2011, "max": 2014},
    {"label": "2015 et après", "min": 2015}
  ],
  "cohorte_cible": "1995-2010",
  "statut": {
    "heures_an": 8760,
    "dormante_max": 0.05,
    "faible_max": 0.15,
    "labels": {"dormante": "Dormante (< 5 %)", "faible": "Faible (5-15 %)", "active": "Active (> 15 %)", "na": "Non renseigné"}
  },
  "fin_contrat": {"duree_ans": 12, "echeance_max_oa": 2031},
  "usage_probable": {
    "Industrie / agro": "USINE|PAPET|CARTON|SUCRE|LAIT|FROMAG|CHIMIE|BRASSERIE|AGRO|INDUSTR|VERRE|TEXTILE|MALT|AMIDON|DISTILL|ARKEMA|LESAFFRE|COOPERL|SERUM|GRTGAZ|NORENERGY",
    "Hôpital / santé": "HOPITAL|HÔPITAL|\\bCH\\b|CHU|CHR|CLINIQUE|HOSPITAL|CENTRE HOSP|\\bCHI\\b",
    "Réseau de chaleur / urbain": "CHAUFF|RESEAU|RÉSEAU|CHALEUR|URBAIN|ZUP|ZAC|CITE|CITÉ|QUARTIER|SDC|ENERGIE VERTE|DISTRIBUTION|ENERGIE$",
    "Serres / agricole": "SERRE|MARAICH|HORTI|TOMATE|PEPINI|LEGUM|EARL|SCEA|GAEC",
    "Campus / piscine": "PISCINE|AQUAT|UNIVERS|CAMPUS|LYCEE|STADE"
  },
  "tranches_puissance_mw": [[1, 3], [3, 6], [6, 12], [12, 20]],
  "regions_prioritaires": ["Île-de-France", "Hauts-de-France", "Normandie"]
}
